gwsw:ZwartAfvalwater rdfs:label "Black water"@en, "Zwart afvalwater"@nl;
    gwsw:hasAuthorChange "Marinus Vonhof", "Eric van Gorkom";
    gwsw:hasDateChange "2016-04-24"^^xsd:date, "2024-05-13"^^xsd:date;
    skos:definition "De (gemengde) waterstroom uit het toilet. Bij gebruik van vacuümtoiletten wordt een ingedikte vorm verkregen. Vanwege de aanwezige fecaliën zal het afvalwater na enige tijd zwart kleuren"@nl;
    rdfs:seeAlso "[EN 16323:2014] Domestic wastewater contaminated only with faecal matter, urine and toilet paper"@en, "[EN 16323:2014] Huishoudelijk afvalwater dat alleen verontreinigd is met fecaliën, urine en toiletpapier"@nl;
    gwsw:hasAuthorStart "Marinus Vonhof";
    gwsw:hasDateStart "2016-04-15"^^xsd:date;
    skos:altLabel "Zwart water"@nl;
    skos:scopeNote gwsw:Cof_BAS;
    a owl:Class;
    rdfs:subClassOf gwsw:Afvalwater.
gwsw:ADAa rdfs:label "Geen neerslag"@nl, "No precipitation"@en;
    skos:notation "A"^^gwsw:Dt_Notation_IR;
    a gwsw:PrecipitationColl.
gwsw:ADAb rdfs:label "Rain"@en, "Regen"@nl;
    skos:notation "B"^^gwsw:Dt_Notation_IR;
    a gwsw:PrecipitationColl.
gwsw:ADAc rdfs:label "Melting snow or ice"@en, "Smeltende sneeuw of smeltend ijs"@nl;
    skos:notation "C"^^gwsw:Dt_Notation_IR;
    a gwsw:PrecipitationColl.
gwsw:BDFba rdfs:label "Oxygen deficiency"@en, "Zuurstoftekort"@nl;
    skos:notation "A"^^gwsw:Dt_Notation_IR;
    a gwsw:AtmosphereColl, gwsw:TheTypeOfHazardDetectedColl, gwsw:TypeOfHazardManholeColl.
gwsw:BDFbb rdfs:label "Hydrogen sulfide"@en, "Zwavelwaterstof"@nl;
    skos:notation "B"^^gwsw:Dt_Notation_IR;
    a gwsw:AtmosphereColl, gwsw:TheTypeOfHazardDetectedColl, gwsw:TypeOfHazardManholeColl.
gwsw:BDFbc rdfs:label "Methaan"@nl, "Methane"@en;
    skos:notation "C"^^gwsw:Dt_Notation_IR;
    a gwsw:AtmosphereColl, gwsw:TheTypeOfHazardDetectedColl, gwsw:TypeOfHazardManholeColl.
gwsw:CDDd rdfs:label "Ander ontvlambaar gas"@nl, "Other flammable gas"@en;
    skos:notation "D"^^gwsw:Dt_Notation_IR;
    a gwsw:AtmosphereColl.
gwsw:CDDe rdfs:label "Geen gevaarlijke atmosfeer"@nl, "No hazardous atmosphere"@en;
    skos:notation "E"^^gwsw:Dt_Notation_IR;
    a gwsw:AtmosphereColl.
gwsw:z_7 rdfs:label "Anders (zie CDE)"@nl, "Other (see CDE)"@en;
    rdfs:seeAlso "[EN13508-2+A1] Further details should be recorded using a general remarks code (CDE) as the next code"@en, "[EN13508-2+A1] Verdere details behoren te worden vastgelegd door toepassing van een direct volgende algemene opmerkingscode (CDE)."@nl;
    skos:notation "Z"^^gwsw:Dt_Notation_IR;
    a gwsw:AtmosphereColl, gwsw:CircumferentialReferencePointColl, gwsw:MethodOfInspectionManholeColl.
gwsw:BAAba rdfs:label "Vertical - the height of the pipe has been reduced"@en, "Verticaal - de hoogte van de buis is verminderd"@nl;
    skos:notation "A"^^gwsw:Dt_Notation_IR;
    a gwsw:OrientationOfTheDeformationColl.
gwsw:BAAbb rdfs:label "Horizontaal - de breedte van de buis is verminderd"@nl, "Horizontal -the width of the pipe has been reduced"@en;
    skos:notation "B"^^gwsw:Dt_Notation_IR;
    a gwsw:OrientationOfTheDeformationColl.
gwsw:BABba rdfs:label "Oppervlaktescheur - een scheur alleen in het oppervlaK"@nl, "Surface crack - a crack only in the surface"@en;
    skos:notation "A"^^gwsw:Dt_Notation_IR;
    a gwsw:NatureOfTheFissureColl, gwsw:NatureOfTheFissureManholeColl.
gwsw:BABbb rdfs:label "Crack - crack lines visible on the pipe wall, pieces still in place"@en, "Scheur – zichtbare scheurlijnen op de buiswand, brokken nog op hun plaats"@nl;
    skos:notation "B"^^gwsw:Dt_Notation_IR;
    a gwsw:NatureOfTheFissureColl.
gwsw:BABbc rdfs:label "Fracture - crack visibly open in a pipe wall, pieces still in place"@en, "Scheur – zichtbaar open scheuren in de buiswand, brokken nog op hun plaats"@nl;
    skos:notation "C"^^gwsw:Dt_Notation_IR;
    a gwsw:NatureOfTheFissureColl.
gwsw:BABca rdfs:label "Langsrichting (scheur)"@nl, "Longitudinal - A crack or fracture which is mainly parallel to the axis of the pipe"@en;
    skos:notation "A"^^gwsw:Dt_Notation_IR;
    a gwsw:OrientationOfTheFissureColl.
gwsw:BABcb rdfs:label "Circumferential - A crack or fracture which is mainly around the circumference of the pipe"@en, "In de omtrek (scheur)"@nl;
    skos:notation "B"^^gwsw:Dt_Notation_IR;
    a gwsw:OrientationOfTheFissureColl.
gwsw:BABcc rdfs:label "Complex (scheur)"@nl, "Complex - A group of cracks or fractures which cannot be described as longitudinal or circumferential"@en;
    skos:notation "C"^^gwsw:Dt_Notation_IR;
    a gwsw:OrientationOfTheFissureColl, gwsw:OrientationOfTheFissureManholeColl.
gwsw:BABcd rdfs:label "Helical"@en, "Spiraalvormig"@nl;
    skos:notation "D"^^gwsw:Dt_Notation_IR;
    a gwsw:OrientationOfTheFissureColl, gwsw:OrientationLiningColl, gwsw:OrientationDefectiveRepairColl, gwsw:OrientationLiningManholeColl.
gwsw:BABce rdfs:label "Radiating from a point (star fissure)"@en, "Uitgaande vanuit een punt (stervormige scheur)"@nl;
    skos:notation "E"^^gwsw:Dt_Notation_IR;
    a gwsw:OrientationOfTheFissureColl, gwsw:OrientationOfTheFissureManholeColl.
gwsw:BACba rdfs:label "Break - pieces of pipe visibly displaced but not missing"@en, "Breuk – delen van de buis zichtbaar verplaatst, maar niet ontbrekend"@nl;
    skos:notation "A"^^gwsw:Dt_Notation_IR;
    a gwsw:NatureOfTheBreakOrCollapseColl.
gwsw:BACbb rdfs:label "Missing - missing pieces of wall"@en, "Ontbrekend – delen van de wand ontbreken"@nl;
    skos:notation "B"^^gwsw:Dt_Notation_IR;
    a gwsw:NatureOfTheBreakOrCollapseColl, gwsw:NatureOfTheBreakOrCollapseManholeColl.
gwsw:BACbc rdfs:label "Collapse - complete loss of structural integrity"@en, "Instorting – compleet verlies van structurele stabiliteit"@nl;
    skos:notation "C"^^gwsw:Dt_Notation_IR;
    a gwsw:NatureOfTheBreakOrCollapseColl, gwsw:NatureOfTheBreakOrCollapseManholeColl, gwsw:ExtentOfDisplacementManholeColl.
gwsw:BADba rdfs:label "Displaced - bricks or masonry units still present but displaced from their original position"@en, "Verplaatst"@nl;
    skos:notation "A"^^gwsw:Dt_Notation_IR;
    a gwsw:ExtentOfDisplacementColl, gwsw:ExtentOfDisplacementManholeColl.
gwsw:BADbb rdfs:label "Missing - bricks or masonry units missing from their original position"@en, "Ontbrekend"@nl;
    skos:notation "B"^^gwsw:Dt_Notation_IR;
    a gwsw:ExtentOfDisplacementColl.
gwsw:BADbc rdfs:label "Dropped invert -A section of the invert of a brick or masonry pipeline has dropped in relation to the walls leaving a gap of more than 20 mm"@en, "Ingezakte bodem"@nl;
    skos:notation "C"^^gwsw:Dt_Notation_IR;
    a gwsw:ExtentOfDisplacementColl.
gwsw:BADbd rdfs:label "Collapse - complete loss of structural integrity (brickwork)"@en, "Instorting"@nl;
    skos:notation "D"^^gwsw:Dt_Notation_IR;
    a gwsw:ExtentOfDisplacementColl.
gwsw:BADca rdfs:label "Another layer of brickwork or masonry visible - though the hole left by the missing brickwork"@en, "Een volgende laag bakstenen of metselwerk is zichtbaar - door het gat dat is ontstaan door het ontbrekende metselwerk"@nl;
    skos:notation "A"^^gwsw:Dt_Notation_IR;
    a gwsw:MissingBricksOrMasonryColl.
gwsw:BADcb rdfs:label "Niets is zichtbaar - het  is niet mogelijk vast te stellen wat is bloot komen te liggen door de ontbrekende  bakstenen of het ontbrekend metselwerk"@nl, "Nothing is visible - It is not possible to determine what is exposed by the missing brickwork or masonry"@en;
    skos:notation "B"^^gwsw:Dt_Notation_IR;
    a gwsw:MissingBricksOrMasonryColl, gwsw:MissingBricksOrMasonryManholeColl.
