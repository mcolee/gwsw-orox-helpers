    gwsw:hasAuthorStart "Marinus Vonhof";
    gwsw:hasDateStart "2013-10-01"^^xsd:date;
    gwsw:hasUnit "mm";
    rdfs:comment "[is aspect]";
    skos:scopeNote gwsw:Cof_MDS, gwsw:Cof_PLI, gwsw:Cof_HYD;
