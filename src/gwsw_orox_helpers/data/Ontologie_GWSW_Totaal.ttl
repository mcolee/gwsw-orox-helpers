gwsw:Olie__benzineafscheider rdfs:label "Light liquid separator"@en, "Olie-/benzineafscheider"@nl;
    rdfs:comment "20151014: NEN3300-definitie aangepast";
    gwsw:hasAuthorChange "Finy Teitsma (Oranjewoud)";
    gwsw:hasDateChange "2007-11-12"^^xsd:date;
    skos:definition "Een toestel waarin ten gevolge van het verschil in dichtheid en het vertragen van de vloeistofstroom de olie/benzine door opdrijving grotendeels van het afvalwater wordt gescheiden."@nl;
    rdfs:seeAlso "[EN 16323:2014] device to separate light liquids from wastewater"@en, "[NEN 3300:1996] Toestel bestemd voor de behandeling van oliehoudend afvalwater, waarin door het verschil in dichtheid tussen olie en water  en het vertragen van de vloeistofstroom, olie door opdrijving grotendeels wordt verwijderd"@nl;
    gwsw:hasAuthorStart "Finy Teitsma (Oranjewoud)";
    gwsw:hasDateStart "2007-10-23"^^xsd:date;
    gwsw:hasValidity "*d";
    skos:altLabel "Olieafscheider"@nl;
    skos:scopeNote gwsw:Cof_BAS;
    a owl:Class;
    rdfs:subClassOf gwsw:Constructieonderdeel, _:n3-15537, _:n3-15538, _:n3-15539, _:n3-15540.
