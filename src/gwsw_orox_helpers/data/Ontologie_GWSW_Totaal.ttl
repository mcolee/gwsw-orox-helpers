gwsw:Vetafscheider rdfs:label "Grease separator"@en, "Vetafscheider"@nl;
    rdfs:comment "20151014: NEN3300-definitie aangepast";
    gwsw:hasAuthorChange "Marinus Vonhof";
    gwsw:hasDateChange "2019-05-16"^^xsd:date;
    skos:definition "Een toestel waarin ten gevolge van het verschil in dichtheid en het vertragen van de vloeistofstroom het vet door opdrijving grotendeels van het afvalwater wordt gescheiden. Verticale schotten in de afscheider zorgen ervoor dat het geloosde afvalwater in de put tot rust komt. Door bezinken en opdrijven vindt scheiding plaats van de verontreinigingen die niet op het openbare riool mogen worden geloosd"@nl;
    rdfs:seeAlso "[EN 16323:2014] device to separate grease from wastewater"@en, "[NEN 3300:1996] Toestel bestemd voor de behandeling van met vet verontreinigd afvalwater, waarin ten gevolge van verschil in dichtheid en het vertragen van de vloeistofstroom, vet door opdrijving grotendeels wordt verwijderd uit het afvalwater"@nl;
    gwsw:hasAuthorStart "Finy Teitsma (Oranjewoud)";
    gwsw:hasDateStart "2007-10-23"^^xsd:date;
    gwsw:hasValidity "10d";
    skos:scopeNote gwsw:Cof_REV, gwsw:Cof_BAS;
    a owl:Class;
    rdfs:subClassOf gwsw:Constructieonderdeel, _:n3-18035, _:n3-18036, _:n3-18037, _:n3-18038, _:n3-18039.
