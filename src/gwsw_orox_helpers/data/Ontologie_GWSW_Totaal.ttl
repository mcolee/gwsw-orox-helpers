    rdfs:seeAlso "[EN13508-2+A1] Materiaal dat is gehecht aan de wand van de rioolput of de inspectieput"@nl, "[EN13508-2+A1] Material attached to the wall of the manhole or inspection chamber"@en;
    skos:notation "DBB"^^gwsw:Dt_Notation_IR;
    gwsw:hasAuthorStart "Marinus Vonhof";
