gwsw:Onderbemaling rdfs:label "Onderbemaling"@nl;
    gwsw:hasAuthorChange "Marinus Vonhof", "Eric van Gorkom", "Johan Post";
    gwsw:hasDateChange "2025-01-16"^^xsd:date, "2021-10-01"^^xsd:date, "2024-05-13"^^xsd:date;
    skos:definition "Een deel van een vrijverval rioolstelsel waarvan het ingezamelde afvalwater via een bemaling wordt opgevoerd naar een ander deel van hetzelfde stelsel. Tijdens hemelwaterafvoer functioneert het stelsel (inclusief onderbemalingen) hydraulisch gezien als een geheel."@nl;
    rdfs:seeAlso "file:///img/GebiedVsStelsel.svg";
    gwsw:hasAuthorStart "Marinus Vonhof";
    gwsw:hasDateStart "2016-04-19"^^xsd:date;
    skos:scopeNote gwsw:Cof_BAS;
    a owl:Class;
    rdfs:subClassOf gwsw:VrijvervalRioolstelsel, gwsw:ExtraObjecttype, _:n3-15564, _:n3-15565, _:n3-15566, _:n3-15567, _:n3-15568.
