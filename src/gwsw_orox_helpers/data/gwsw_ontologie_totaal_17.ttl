    gwsw:hasDateChange "2022-09-26"^^xsd:date;
    skos:definition "[EN 16323:2014] flow not affected by rainfall or snow melt"@en, "[NEN 3300:1996] De hoeveelheid afvalwater die per tijdseenheid in een droogweersituatie via het rioolstelsel wordt afgevoerd"@nl, "[NEN-EN 752:2008] afvoer die niet wordt beïnvloed door regenval of smeltwater [EN 1085:2007, definitie 3050]"@nl;
    skos:notation "DWA"^^gwsw:Dt_Notation_HY;
    gwsw:hasAuthorStart "Marinus Vonhof";
    gwsw:hasDateStart "2014-11-29"^^xsd:date;
    rdfs:comment "20151014: NEN3300-definitie aangepast";
