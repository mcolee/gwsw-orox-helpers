    gwsw:hasDateChange "2024-04-30"^^xsd:date, "2024-05-18"^^xsd:date, "2026-05-18"^^xsd:date;
    skos:definition "Een drukrioleringsstelsel waarbij kleine hoeveelheden lucht in het stelsel wordt geïnjecteerd. De luchtinjectie-unit vervangt op strategische plaatsen een bestaande pomp (6 tot 10 % van de pompunits), zorgt voor transport van afvalwater door de persleiding onder luchtdruk en voegt lucht toe aan het rioolwater"@nl;
    gwsw:hasAuthorStart "Marinus Vonhof";
    gwsw:hasDateStart "2020-04-17"^^xsd:date;
    gwsw:hasValidity "1d";
    skos:altLabel "Hybride systeem"@nl;
    skos:scopeNote gwsw:Cof_BAS, gwsw:Cof_RGM, gwsw:Cof_DMO;
    a owl:Class;
    rdfs:subClassOf gwsw:MechanischRioolstelsel, _:n3-13927, _:n3-13928, _:n3-13929, _:n3-13930, _:n3-13931.
