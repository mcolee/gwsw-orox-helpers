gwsw:AnderAfvalwater rdfs:label "Ander afvalwater"@nl;
    gwsw:hasAuthorChange "Marinus Vonhof";
    gwsw:hasDateChange "2016-04-07"^^xsd:date;
    skos:definition "[Waterwet] Datgene wat niet onder een van voorgaande begrippen is te vatten. De wetgever beoogt niet om met bovenstaande begrippen alle soorten afvalwater uitputtend te omschrijven. Een voorbeeld van ‘ander afvalwater’ is ‘ zwembadwater’ bij een particulier huishouden dat geloosd moet worden. Te lozen zwembadwater van een professioneel zwembad is bedrijfsafvalwater"@nl;
    gwsw:hasAuthorStart "Marinus Vonhof";
    gwsw:hasDateStart "2015-03-29"^^xsd:date;
    skos:scopeNote gwsw:Cof_BAS, gwsw:Cof_DMO;
    a owl:Class;
    rdfs:subClassOf gwsw:Afvalwater.
