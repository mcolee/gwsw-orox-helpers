gwsw:BCAc rdfs:label "State of the connection"@en, "Status van de aansluiting"@nl;
    skos:definition "[EN13508-2+A1] A code to indicate whether the connection has been closed. This may indicate a junction provided during construction for future use, or it may indicate that the connection has been cut off. The method of coding is"@en, "[EN13508-2+A1] Een code om aan te geven of een aansluiting is afgesloten, Dit kan een aansluiting zijn voor toekomstig gebruik is gemaakt, of het kan een aansluiting zijn die is afgesloten. De methode van codering is"@nl;
    gwsw:hasAuthorStart "Marinus Vonhof";
    gwsw:hasDateStart "2013-07-19"^^xsd:date;
    rdfs:comment "[is aspect]";
    skos:scopeNote gwsw:Cof_EN;
    a owl:Class;
    rdfs:subClassOf gwsw:Karakterisering2, _:n3-11097, _:n3-11098.
