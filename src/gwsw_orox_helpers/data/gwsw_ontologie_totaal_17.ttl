gwsw:Helofytenfilter rdfs:label "Constructed wetland"@en, "Helofytenfilter"@nl;
    gwsw:hasAuthorChange "Marinus Vonhof", "Johan Post";
    gwsw:hasDateChange "2025-01-16"^^xsd:date, "2021-10-01"^^xsd:date, "2026-05-01"^^xsd:date;
    skos:definition "[EN 16323:2014] construction near to nature using helophyte plants supporting bacterial action in the gravel or sand for treatment of wastewater"@en, "[IMBOR] Functie van rietland. Bed of veld van planten (helofyten) dat, met behulp van zonlicht, water zuivert. Het object kan onderdeel uitmaken van een waterpartij."@nl, "[NEN 3300:1996] afgescheiden gebied beplant met helofyten (riet, biezen etc.) waardoor afvalwater stroomt (horizontaal of verticaal) en door beluchting, bezinking en afzetting wordt gezuiverd. Bij verticale stroming wordt het gezuiverde water afgevoerd door drainage."@nl;
    gwsw:hasAuthorStart "Marinus Vonhof";
    gwsw:hasDateStart "2013-09-29"^^xsd:date;
    rdfs:seeAlso "file:///img/Helofytenfilter.jpg";
    skos:altLabel "Biologisch reinigend filter"@nl;
    skos:scopeNote gwsw:Cof_BAS;
    a owl:Class;
    rdfs:subClassOf gwsw:IBAKlasseIIIa, _:n3-13802, _:n3-13803, _:n3-13804, _:n3-13805.
