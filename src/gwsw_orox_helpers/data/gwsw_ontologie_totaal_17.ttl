gwsw:Node3NodeCoordinate rdfs:label "Knooppuntcoördinaat van knooppunt 3"@nl, "Node 3 node coordinate"@en;
    skos:definition "[EN13508-2+A1] Waar de inspectie een zijaansluiting vanaf een hoofdleiding is, is de plaatsreferentie (coordinaten) van het derde knooppunt."@nl, "[EN13508-2+A1] Where the inspection is of a lateral from a main pipeline, the grid reference (coordinates) of the third node"@en;
    skos:notation "AAU"^^gwsw:Dt_Notation_IL;
    gwsw:hasAuthorStart "Marinus Vonhof";
    gwsw:hasDateStart "2013-12-24"^^xsd:date;
