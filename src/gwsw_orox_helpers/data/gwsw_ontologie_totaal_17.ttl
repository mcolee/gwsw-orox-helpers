gwsw:DAL rdfs:label "Defectieve reparatie (put)"@nl, "Defective repair (manhole)"@en;
    gwsw:hasAuthorChange "Marinus Vonhof";
    gwsw:hasDateChange "2014-08-06"^^xsd:date;
    skos:definition "[EN13508-2+A1] A repair has been carried out on the manhole or inspection chamber which now has a defect. Where this code is used a point repair code DCB is also required. Where the repair is a localised lining (DCB B) code DAK should be used."@en, "[EN13508-2+A1] Aan de rioolput of inspectieput is een reparatie uitgevoerd, die nu een defect vertoont. Als deze code wordt toegepast, is ook de plaatselijke reparatiecode DCB vereist. Waar de reparatie een plaatselijke lining is (DCB B) behoort code DAK te worden gebruikt."@nl;
    skos:notation "DAL"^^gwsw:Dt_Notation_IR;
    gwsw:hasAuthorStart "Marinus Vonhof";
    gwsw:hasDateStart "2012-08-15"^^xsd:date;
    skos:scopeNote gwsw:Cof_EN;
    a owl:Class;
    rdfs:subClassOf gwsw:WaarnemingConstructieRioolput, _:n3-12248, _:n3-12249, _:n3-12250, _:n3-12251.
