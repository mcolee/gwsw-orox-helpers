gwsw:Foutaansluiting rdfs:label "Foutaansluiting"@nl;
    gwsw:hasAuthorChange "Marinus Vonhof";
    gwsw:hasDateChange "2025-01-16"^^xsd:date, "2024-08-01"^^xsd:date;
    skos:definition "Een aansluiting (van perceel of kolk) op een andersoortig type rioolstelsel die de goede werking van een rioolstelsel belemmert. In principe zijn drie soorten foutaansluitingen mogelijk: / 1 De afvalwaterafvoer is aangesloten op het hemelwaterriool. / 2 De hemelwaterafvoer is aangesloten op het vuilwaterriool of op drukriolering. / 3 De afvalwater- en hemelwaterafvoer zijn omgedraaid en aangesloten op respectievelijk het hemelwater- en vuilwaterriool."@nl;
    gwsw:hasAuthorStart "Marinus Vonhof";
    gwsw:hasDateStart "2018-12-06"^^xsd:date;
    skos:scopeNote gwsw:Cof_BAS;
    a owl:Class;
    rdfs:subClassOf gwsw:Aansluiting, gwsw:ExtraObjecttype, _:n3-13466.
