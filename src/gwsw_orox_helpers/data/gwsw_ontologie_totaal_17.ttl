gwsw:DAA rdfs:label "Deformatie (put)"@nl, "Deformation (manhole)"@en;
    gwsw:hasAuthorChange "Marinus Vonhof";
    gwsw:hasDateChange "2018-11-15"^^xsd:date;
    skos:definition "[EN13508-2+A1] De vorm van de dwarsdoorsnede van de rioolput of inspectieput is gedeformeerd ten opzichte van de oorspronkelijke vorm. Dit kan óf vergezeld gaan met andere defecten als scheuren óf het kan op zichzelf optreden bij flexibele materialen."@nl, "[EN13508-2+A1] The cross sectional shape of the manhole or inspection chamber has been deformed from its original shape. This can either be associated with other defects such as fissure or in flexible materials it may occur on its own."@en;
    skos:notation "DAA"^^gwsw:Dt_Notation_IR;
    gwsw:hasAuthorStart "Marinus Vonhof";
    gwsw:hasDateStart "2012-08-15"^^xsd:date;
    skos:scopeNote gwsw:Cof_EN;
    a owl:Class;
    rdfs:subClassOf gwsw:WaarnemingConstructieRioolput, _:n3-12085, _:n3-12086, _:n3-12087, _:n3-12088.
