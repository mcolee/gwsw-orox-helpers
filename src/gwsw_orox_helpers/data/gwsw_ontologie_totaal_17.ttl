gwsw:BCA rdfs:label "Aansluiting (waarneming)"@nl, "Connection (observation)"@en;
    gwsw:hasAuthorChange "Marinus Vonhof";
    gwsw:hasDateChange "2020-04-20"^^xsd:date;
    skos:definition "[EN13508-2+A1] Another pipeline is connected to the pipeline being inspected. The employing authority may determine that where a connecting branch is equal to the size of the pipeline or where it is greater than a specified size, the location of a connection should be regarded as a node. It is assumed that the majority of connections recorded using this code will be circular in section."@en, "[EN13508-2+A1] Een andere leiding is verbonden met de leiding die wordt geïnspecteerd. De bevoegde instantie mag vaststellen dat, waar een aansluiting gelijk is aan de afmeting van de leiding of waar het groter is dan een gespecificeerde afmeting, de plaats van een aansluiting behoort te worden beschouwd als een knooppunt. Er wordt aangenomen dat de meerderheid van de geregistreerde aansluitingen, waar deze code op van toepassing is, een cirkelvormige dwarsdoorsnede hebben."@nl;
    skos:notation "BCA"^^gwsw:Dt_Notation_IR;
    gwsw:hasAuthorStart "Marinus Vonhof";
    gwsw:hasDateStart "2012-08-15"^^xsd:date;
    rdfs:seeAlso "file:///img/EN13508_BCA_AA.jpg", "[Leidraad 2019] Omschrijving positie en materiaal van de aansluiting als opmerking opnemen"@nl;
    skos:scopeNote gwsw:Cof_EN;
    a owl:Class;
    rdfs:subClassOf gwsw:WaarnemingKenmerkenLeiding, _:n3-11088, _:n3-11089, _:n3-11090, _:n3-11091, _:n3-11092, _:n3-11093.
gwsw:WaarnemingKenmerkenLeiding rdfs:label "Observation relating to the inventory of the pipeline"@en, "Waarneming kenmerken leiding"@nl;
    gwsw:hasAuthorChange "Marinus Vonhof";
    gwsw:hasDateChange "2018-12-07"^^xsd:date;
    skos:definition "[EN13508-2+A1] Table 6 — Details of inventory Codes"@en;
    gwsw:hasAuthorStart "Marinus Vonhof";
    gwsw:hasDateStart "2013-07-18"^^xsd:date;
    skos:scopeNote gwsw:Cof_EN;
    a owl:Class;
    rdfs:subClassOf gwsw:Waarneming.
