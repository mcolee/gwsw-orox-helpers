gwsw:DeelmodelTotaal rdfs:label "Deelmodel Totaal"@nl;
    gwsw:hasAuthorChange "Marinus Vonhof";
    gwsw:hasDateChange "2021-09-17"^^xsd:date, "2025-12-03"^^xsd:date;
    skos:definition "Bevat alle vastgestelde GWSW-deelmodellen en de concept-deelmodellen die ter visie liggen. Die GWSW-deelmodellen beschrijven de ligging en uitvoering voor voorzieningen, het uitvoeren van inspectie- en reinigingsprojecten, het uitvoeren van revisie/inmeet-projecten, de netwerken voor hydraulische modellering, afvoerscenario's en kengetallen, de NLCS-symbolen voor geo-toepassingen."@nl;
