:Inspectieput_17_dek
	rdf:type                      gwsw:Putdeksel ;
  rdfs:label                    "Deksel 0979" . # Label bij onderdeel is nodig voor GIS-presentaties
:Inspectieput_17_dek
	gwsw:hasAspect                # gebruik verkorte turtle-notatie: alle eigenschappen (met hasAspect-relatie)
                                [ rdf:type gwsw:MateriaalDeksel ; gwsw:hasReference gwsw:Gietijzer ] ,
                                [ rdf:type gwsw:VormDeksel ; gwsw:hasReference gwsw:Rond ] ,
                                [ rdf:type gwsw:BelastingklasseDIN19580_EN1433 ; gwsw:hasReference gwsw:KlasseC250 ] , # vanaf GWSW versie 1.6
                                :Inspectieput_17_dek_ori .
:Inspectieput_17_dek_ori        # Orientatie erbij (geometrie, ligging)
	rdf:type                      gwsw:Dekselorientatie ; 
	gwsw:hasAspect                [ # Exacte locatie van de deksel erbij (bij meerdere deksels of indien niet boven hart put of voor GIS-presentaties)
  	rdf:type                    gwsw:Punt ;
	  gwsw:hasValue               "<gml:Point xmlns:gml=\"http://www.opengis.net/gml\"><gml:pos>168462.51 442691.30</gml:pos></gml:Point>"^^geo:gmlLiteral ] ;
  gwsw:hasAspect                :Inspectieput_17_dek_niv .
:Inspectieput_17_dek_niv        # Het dekselniveau is een eigenschap van de orientatie
  rdf:type                      gwsw:Putdekselniveau ;
  gwsw:hasValue                 22.15 ; # Deksel ligt onder maaiveld (verdekte put)
	gwsw:hasAspect                [ # Het kenmerk heeft meta-gegevens over de inwinning
  	rdf:type                    gwsw:Inwinning ;
    gwsw:hasAspect              [ 
      rdf:type                  gwsw:WijzeVanInwinning ; 
      gwsw:hasReference         gwsw:Inmeting ] ; # Vanaf GWSW 1.6
    gwsw:hasAspect              [ 
      rdf:type                  gwsw:DatumInwinning ; 
      gwsw:hasValue             "2022-04-05"^^xsd:date ] ; ] .

